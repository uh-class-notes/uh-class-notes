// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  password     String
  role         Role         @default(USER)
  savedClasses SavedClass[]
  notes        NoteData[]
}

model Offering {
  id       Int          @id @default(autoincrement())
  termId   Int
  courseId Int
  campcode String
  crn      String
  seqnumb  String
  lastName String?
  term     Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  savedBy  SavedClass[]

  @@unique([termId, campcode, crn])
  @@index([termId, courseId])
}

model Term {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  year      Int
  semester  String
  offerings Offering[]
}

model Course {
  id          Int        @id @default(autoincrement())
  subjcode    String
  crsenumb    String
  name        String
  subjectName String
  offerings   Offering[]

  @@unique([subjcode, crsenumb])
  @@index([subjcode, crsenumb])
}

model SavedClass {
  id         Int      @id @default(autoincrement())
  userId     Int
  offeringId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([userId, offeringId])
}

model NoteData {
  id          Int     @id @default(autoincrement())
  title       String
  userId      Int
  semester    String
  subjcode    String
  crsenumb    String
  section     String?
  instructor  String?
  imageData   Bytes?  @db.ByteA
  imageUrl    String?
  textContent String?
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([semester, subjcode, crsenumb])
}
