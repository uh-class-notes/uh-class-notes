// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  password       String
  role           Role         @default(USER)
  savedClasses   SavedClass[]
  notes          NoteData[]
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

model ClassData {
  id          Int          @id @default(autoincrement())
  campcode    String
  crn         String       @unique
  subjcode    String
  crsenumb    String
  seqnumb     String
  lastName    String?
  subjectName String
  savedBy     SavedClass[]

  @@index([campcode, subjcode, crsenumb])
}

model SavedClass {
  id              Int           @id @default(autoincrement())
  userId          Int
  classDataId     Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  classData       ClassData     @relation(fields: [classDataId], references: [id], onDelete: Cascade)

  @@unique([userId, classDataId])
}

model NoteData {
  id          Int           @id @default(autoincrement())
  title       String
  userId      Int
  semester    String
  subjcode    String
  crsenumb    String
  section     String?
  instructor  String?
  imageData   Bytes?        @db.ByteA
  imageUrl    String?
  textContent String?
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([semester, subjcode, crsenumb])
}
